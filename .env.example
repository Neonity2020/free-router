OPENROUTER_API_KEY=
OPENCODE_API_KEY=
COMMANDCODE_API_KEY=
# Optional local gateway bearer token. Restart backend after changes.
GATEWAY_API_KEY=
HOST=127.0.0.1
PORT=8787
DEFAULT_PROVIDER=opencode
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
# Optional Pi Agent defaults. Node.js 22.19+ is required for coding tools.
# PI_AGENT_WORKSPACE=/absolute/path/to/project
# PI_NODE_BIN=/absolute/path/to/node

# Total chat request budget across all keys/providers, including response streaming (1–86400).
GATEWAY_REQUEST_TIMEOUT_SECS=300
